<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.foreman.serve</string>
  <key>ProgramArguments</key>
  <array>
    <string>@FOREMAN@</string>
    <string>serve</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>FOREMAN_HOME</key>
    <string>@FOREMAN_HOME@</string>
    <key>PATH</key>
    <string>@PATH@</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>@FOREMAN_HOME@/serve.log</string>
  <key>StandardErrorPath</key>
  <string>@FOREMAN_HOME@/serve.log</string>
</dict>
</plist>
